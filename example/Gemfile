source 'https://rubygems.org'

gem 'puma', '>= 5.0'
gem 'pg', '~> 1.5'
gem 'rails', '~> 8.1.4'

# The library this app demonstrates, straight from this repository.
gem 'lighthouse-graphql', path: '..'

# Optional integrations Lighthouse uses when an app has them: Pundit backs the
# @can* directives, Dry::Validation the @validator contracts.
gem 'dry-validation', '~> 1.10'
gem 'pundit', '~> 2.4'

# @async runs mutations through ActiveJob; this app queues them in Solid Queue,
# Rails' default, in its own database.
gem 'solid_queue', '~> 1.2'

# Query.posts(search:) searches in PostgreSQL through @search and Post's pg_search scope.
gem 'pg_search', '~> 2.3'

# The other backends the end-to-end suite also runs against
# (spec/requests/graphql/real_backends_spec.rb): DATABASE_URL picks MySQL instead
# of PostgreSQL, REDIS_URL a Redis cache store for @throttle.
gem 'redis', '~> 5.0', require: false
gem 'trilogy', '~> 2.9', require: false

# Searchkick, which spec/requests/graphql/search_spec.rb runs @search through
# against OpenSearch when OPENSEARCH_URL is set.
gem 'opensearch-ruby', '~> 3.4', require: false
gem 'searchkick', '~> 6.1', require: false

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: %i[windows jruby]

group :development, :test do
  gem 'debug', platforms: %i[mri windows], require: 'debug/prelude'
  gem 'factory_bot_rails', '~> 6.4'
  gem 'rspec-rails', '~> 8.0'
end

# The suite's PostgreSQL, started on a port Docker picks (spec/postgres_container.rb).
group :test do
  gem 'testcontainers-postgres', '~> 0.2', require: false
end
