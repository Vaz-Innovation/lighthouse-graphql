# Full-text search for @search: the query the directives write to, the result an
# engine outside the database answers with, and the adapters of the two gems.
# The adapter protocol (_SearchAdapter) is experimental. See docs/filtering-and-ordering.md.
module Lighthouse
  module Search
    # The adapter in use: Config.search, else the detecting Search::Auto.
    def self.adapter: () -> (_SearchAdapter | _SearchAdapterChooser)

    # The adapter that searches the model (within the scope or index `index` names), or nil.
    def self.adapter_for: (Class model, ?String? index) -> _SearchAdapter?

    # The scope a model may define for what a search of it may return: `search_results`.
    RESULTS_SCOPE: Symbol

    # Does the model have a `search_results` scope?
    def self.results_scope?: (Class model) -> bool

    # The relation through the model's `search_results` scope, if it has one.
    def self.results: (_ModelRelation relation) -> _ModelRelation

    # Does the field have an argument or input field with @search? Walked once per field.
    def self.searching?: (_FieldDefinition field_def) -> bool

    # What a search holds: the model, the term and what narrows it.
    class Query
      attr_reader model: Class
      attr_reader term: String
      attr_reader index: String?
      # [column, value] pairs, from @eq, all of which hold.
      attr_reader wheres: Array[[String, untyped]]
      # Adapter-specific options, from @builder on an argument.
      attr_reader options: Hash[Symbol, untyped]
      # :with, :only or :without, from @trashed; nil: not given.
      attr_accessor trashed: (:with | :only | :without)?

      def initialize: (Class model, String term, ?String? index) -> void
      def where: (String | Symbol column, untyped value) -> self
    end

    # A search an engine answers: the page it is asked for and its total.
    class Result
      MAX_WINDOW: Integer

      attr_reader query: Query

      # The fiber-local key of the search @canQuery checked, while the field it checks resolves.
      CHECKED: Symbol

      # The block, in which the search of the same field is `result`, the one @canQuery checked.
      def self.serving: [T] (Result? result) { () -> T } -> T
      # The search @canQuery checked in this resolution, when it is this one; else nil.
      def self.checked: (_EngineSearchAdapter adapter, Query query, String? field) -> Result?

      # `field`: "Type.field", whose search it is.
      def initialize: (_EngineSearchAdapter adapter, Query query, ?context: untyped, ?field: String?) -> void
      def same_search?: (_EngineSearchAdapter adapter, Query query, String? field) -> bool
      def window: (Integer offset, Integer limit) -> Array[_Record]
      def count: () -> Integer
      READ_LIMIT: Integer

      def records: (?first: Integer?, ?offset: Integer?) -> Array[_Record]
      # Every record a page can reach, for @canQuery, in a request of its own: READ_LIMIT at most, else a GraphQL::ExecutionError.
      def every_record: () -> Array[_Record]
      # Did the last `records` answer fewer than asked while more match? How many can a page reach?
      def truncated?: () -> bool
      def reachable: () -> Integer
      # How many of the matches the engine pages through: the adapter's `result_window(query)`, else MAX_WINDOW; nil when the adapter cannot tell.
      def result_window: () -> Integer?
    end

    # Searchkick (Elasticsearch / OpenSearch), outside the database.
    class Searchkick
      include _EngineSearchAdapter

      DEFAULT_TRASHED_COLUMN: String
      DEEP_PAGING_WINDOW: Integer

      # @trashed filters on the column Config.soft_deletes tells (Support::SoftDeletes.column).
      # `index`: what the engine tells of an index, read and kept.
      def initialize: (?index: Searchkick::Index) -> void

      # Why the model cannot be searched as it is (a narrowing default scope or search_results, without search_where), or nil.
      def model_error: (Class model) -> String?

      # The index's max_result_window, read from the engine; else the model's options', else 10,000.
      def result_window: (Query query) -> Integer

      # What an @builder may ask of Searchkick's search, and which conditions the database applies alike.
      module Options
        # The options of Searchkick's search an @builder may set, and the keys of its body_options.
        BUILDER_OPTIONS: Array[Symbol]
        BODY_OPTIONS: Array[Symbol]
        # The values the database compares a column with as the engine does.
        SQL_SCALARS: Array[Module]
      end

      # An index's mapping and max_result_window, read from the engine once per INDEX_READ_TTL seconds (a failed read FAILED_READ_TTL).
      class Index
        INDEX_READ_TTL: Integer
        FAILED_READ_TTL: Integer

        # `clock`: seconds, monotonic.
        def initialize: (?clock: ^() -> Numeric) -> void
        def fields: (Class model, String? name) -> Array[String]?
        def result_window: (Class model, String? name) -> Integer?
        # Why the last read of the index's `:mapping` or `:window` failed, while that is kept.
        def failure: (:mapping | :window kind, Class model, String? name) -> StandardError?
      end
    end

    # pg_search (PostgreSQL full-text search), in the database.
    class PgSearch
      include _RelationalSearchAdapter

      DEFAULT_SCOPE: Symbol

      # Does `index` name one of the model's pg_search scopes?
      def named?: (Class model, String? index) -> bool
    end

    # Picks Searchkick, then pg_search, per model.
    class Auto
      include _SearchAdapterChooser

      def initialize: (?Array[_SearchAdapter]? adapters) -> void
      def searchable?: (Class model, ?String? index) -> bool
    end
  end
end
