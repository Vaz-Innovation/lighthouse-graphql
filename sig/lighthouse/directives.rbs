# The extension points for custom directives: the contracts a directive class
# includes, the registry it is registered in, and the base classes it can
# subclass. See docs/custom-directives.md.
module Lighthouse
  # What the registry asks a self-describing directive class: its SDL name
  # (without the @) and its `directive @name(...) on ...` definition.
  interface _DirectiveClass
    def directive_name: () -> String
    def definition: () -> String?
  end

  # Marker modules: the registry detects a class's capabilities by which of
  # them it includes. Only FieldResolver and ArgBuilder change how a class is
  # registered; the others document intent.
  module Contracts
    module Directive
    end

    # Its instances, built with (field_def, type_def, directive_node, opts),
    # install the field's resolver in `define_resolver(target_type)`. Its class
    # says whether it applies a @search on its field (by default, it does not).
    module FieldResolver
      include Directive

      # The class methods a resolver gets with the contract, and overrides to opt in.
      module SearchDefaults
        def applies_search?: () -> bool
        def takes_search_results?: (_NamedType type, _FieldDefinition field_def, _DirectiveNode? directive, Symbol? root_kind) -> bool
      end

      # What Search::FieldCheck asks of a resolver class, with or without the contract.
      def self.applies_search?: (Class klass) -> bool
      def self.takes_search_results?: (Class klass, _NamedType type, _FieldDefinition field_def, _DirectiveNode? directive, Symbol? root_kind) -> bool
    end

    # Its instances, built with (arg_node, directive_node), answer
    # `handle_builder(relation, value)` with the constrained relation.
    module ArgBuilder
      include Directive
    end

    module FieldMiddleware
      include Directive
    end

    module FieldManipulator
      include Directive
    end

    # Its instances, built with (arg_node, directive_node), answer
    # `manipulate_arg_definition(document_ast, field_node, type_node)` with the argument node.
    module ArgManipulator
      include Directive
    end

    # Its instances, built with (field_node, directive_node), answer
    # `handle_field_builder(relation)` with the constrained relation.
    module FieldBuilder
      include Directive
    end

    # An argument directive that also narrows a full-text search: its instances,
    # built with (arg_node, directive_node), answer `handle_search_builder(query, value)`
    # with the Search::Query. @eq, @trashed and @builder on an argument do.
    module SearchBuilder
      include Directive
    end
  end

  class DirectiveRegistry
    RESOLUTION_ORDER: Hash[String, Integer]
    NAMED_RESOLVERS: Hash[String, Symbol]
    SELF_DESCRIBING_RESOLVERS: Array[Symbol]
    ARG_BUILDERS: Array[Symbol]
    PASSIVE_DEFINITIONS: Hash[String, String]

    def self.default: () -> DirectiveRegistry

    # register(MyDirective) when the class answers `directive_name`, else
    # register('name', MyDirective).
    def self.register: (Class | String | Symbol name_or_klass, ?Class? klass) -> DirectiveRegistry

    def initialize: () -> void
    def register: (Class | String | Symbol name_or_klass, ?Class? klass) -> self
    def register_defaults: () -> self
    def register_definition: (String | Symbol name, String definition) -> self
    def register_type_definition: (String | Symbol name, String definition) -> self
    def register_manipulator: (_SdlManipulator manipulator) -> self

    def resolution_class: (String | Symbol name) -> Class?
    def resolution_order: (String | Symbol name) -> Integer
    def wrapper?: (String | Symbol name) -> bool
    def resolution_names: () -> Array[String]
    def arg_builder_class: (String | Symbol name) -> Class?
    def arg_builder_names: () -> Array[String]
    def arg_manipulator_class: (String | Symbol name) -> Class?
    def arg_manipulator_classes: () -> Array[Class]
    def field_builder_class: (String | Symbol name) -> Class?

    # { "name" => "directive @name(...) on ..." }
    def directive_definitions: () -> Hash[String, String]
    # { "Name" => "enum Name { ... }" }
    def type_definitions: () -> Hash[String, String]

    attr_reader sdl_manipulators: Array[_SdlManipulator]
    def manipulate_sdl: (String sdl) -> String
  end

  module GraphQL
    # The schema clients see, printed (`bin/rails lighthouse:print_schema`), and
    # Config.schema_output's file, kept up to date in development.
    module SchemaPrinter
      FORMATS: Array[String]
      FILENAMES: Hash[String, String]

      # Config.schema_output, resolved: an absolute path, the schema's class name, the format.
      type output = { path: Pathname, schema: String?, format: String }

      def self?.print: (_Schema schema, ?format: String | Symbol) -> String
      def self?.app_schema: (?String? name) -> _Schema
      def self?.output: () -> output?
      def self?.output_content: (?output? setting) -> String
      # Writes unless the file holds `content` already; true when it wrote.
      def self?.write: (path path, String content) -> bool
      def self?.stale?: (?output? setting) -> bool
    end

    # Development's report on the schema, on boot and every reload: logged
    # with Config.schema_log; schema_output's file rewritten.
    module SchemaReport
      LIST_LIMIT: Integer

      # The report's [level, text] lines; nil when there is nothing to do.
      def self?.refresh: (?logger: _Logger?) -> Array[[Symbol, String]]?
      def self?.report: (SchemaPrinter::output? output) -> Array[[Symbol, String]]
    end
  end

  # Writes the SDL an IDE needs next to the app's own: `bin/rails lighthouse:ide_helper`.
  module IdeHelper
    DIRECTIVES_FILE: String
    PROGRAMMATIC_TYPES_FILE: String

    # Writes both files into `output_dir` and returns their paths.
    def self?.write: (output_dir: path, ?schema_path: path?, ?registry: DirectiveRegistry) -> Array[String]
    # Config.ide_helper's rewrite, on boot and every reload.
    def self?.refresh: (?output_dir: path) -> Array[String]
    def self?.directives_sdl: (?String sdl, ?registry: DirectiveRegistry) -> String
    def self?.programmatic_types_sdl: (String sdl, ?registry: DirectiveRegistry, ?directives: String) -> String
  end

  module GraphQL
    module DirectiveResolvers
      # The base of the built-in field directives, and of a custom one:
      # subclass it and implement `define_resolver`.
      class BaseDirectiveResolver
        # graphql-ruby's field and type definitions, and the directive's AST node
        # (nil for a resolver no directive names, as the conventional ones).
        @field_def: _FieldDefinition
        @type_def: _NamedType
        @directive_node: _DirectiveNode?
        # Options FieldResolverStack passes: :root_kind, :bases, :phase, :argument, ...
        @opts: Hash[Symbol, untyped]

        def initialize: (_FieldDefinition field_def, _NamedType type_def, _DirectiveNode? directive_node, ?Hash[Symbol, untyped] opts) -> void

        # Asked when the schema is built, of the field's resolving directive's class (Search::FieldCheck):
        # does it run the field's argument filters, a relational search among them?
        def self.applies_search?: () -> bool
        # Does it take the records a search engine outside the database answers with, on this field?
        def self.takes_search_results?: (_NamedType type, _FieldDefinition field_def, _DirectiveNode? directive, Symbol? root_kind) -> bool

        # Install the field's resolver on `target_type_class` (a graphql-ruby type class).
        def define_resolver: (Class target_type_class) -> void

        # `ctx`: the query's context, which @builder on an argument receives.
        # `search`: nil, a relation only; :model, a Search::Result for the model's own relation; :given, one for a relation the app's code gave.
        def apply_where_filters: (relation relation, _ArgumentSet? args, ?context? ctx, ?search: (:model | :given)?) -> (relation | Search::Result)
        def apply_arg_builders: (relation relation, arguments args_h, ?context? ctx) -> relation
        def apply_field_builders: (relation relation, ?arguments args_h, ?context? ctx, ?strict: bool) -> relation
        def constantize_model: (String? name) -> Class?
        def apply_scopes: (relation relation) -> relation

        # The literal value of an argument of this directive.
        def directive_arg: (String name) -> literal
        def resolver_method_name: () -> String
        # The field's resolver so far, for a directive that wraps it.
        def capture_inner: (Class target_type_class) -> _Resolver
        def install: (Class target_type_class, _Resolver callable) -> void
        # The model the directive acts on; raises DefinitionError when there is none.
        def model_class: () -> Class
      end

      # Applies the field's @builder directives, in SDL order, to its relation.
      class BuilderApplier
        DEFINITION: String

        # `strict`: a builder that raises fails the query, rather than be reported and skipped.
        def self.apply: (relation relation, _NamedNode? field_def_ast_node, arguments args, context? ctx, ?strict: bool) -> relation
        def self.apply_directive: (relation relation, _DirectiveNode directive_node, arguments args, context? ctx, ?strict: bool) -> relation
        def self.extract_directive_arg: (_DirectiveNode directive_node, String name) -> literal
      end
    end

    module Directives
      module Arguments
        # The base of the argument filters (@eq, @in, @orderBy, ...), and of a
        # custom one: subclass it and implement `handle_builder`.
        class Base
          include Contracts::ArgBuilder

          # graphql-ruby's AST nodes for the argument and the directive on it.
          @arg_node: _Named
          @directive_node: _DirectiveNode

          def initialize: (_Named arg_node, _DirectiveNode directive_node) -> void

          # Constrain the relation by the value the client gave the argument
          # (whatever its type allows, so untyped).
          def handle_builder: (relation relation, untyped value) -> relation

          private

          # The directive's `key:`, else the argument's name in snake_case.
          def column: () -> String
          def arel_column: (relation relation) -> _ArelNode
        end
      end
    end
  end
end
