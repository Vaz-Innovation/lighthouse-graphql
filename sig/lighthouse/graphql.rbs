# The entrypoints: building the schema from SDL and running operations.
module Lighthouse
  module GraphQL
    VERSION: String

    Config: singleton(Lighthouse::Config)

    # A GraphQL::Schema subclass.
    type schema = _Schema

    module RbLightHouse
      # The schema built from the SDL `schema_path` (default: Config.schema_path) and its imports.
      # `options` takes :base_types, :base_schema and the schema's own options.
      def self.get_schema: (?schema_path: path?, ?options: Hash[Symbol, untyped]) -> schema
      def self.configure: () ?{ (singleton(Lighthouse::Config) config) -> void } -> void
    end

    module SchemaFactory
      def self?.build_base_schema: (?schema_path: path?, ?sdl: String?, ?base_types: Hash[Symbol, Module],
                                    ?schema_options: Hash[Symbol, untyped], **untyped extra_options) -> schema
      def self?.load_sdl: (?path? schema_path) -> String
    end

    # Reads the schema from its entrypoint, pasting in what it #imports.
    class SchemaStitcher
      IMPORT: String

      attr_reader root_schema_path: String

      def initialize: (path root_schema_path) -> void
      def schema_string: () -> String
      # Every file the schema is read from, the entrypoint first.
      def files: () -> Array[String]
    end

    # The schema document the manipulation phase works on: each type defined once.
    class DocumentAST
      KEYWORDS: Hash[Class, String]
      EXTENSIONS: Array[Class]

      attr_reader types: Hash[String, _NamedNode]
      attr_reader type_extensions: Hash[String, Array[_NamedNode]]
      attr_reader directives: Hash[String, _NamedNode]
      attr_reader schema_definitions: Array[_Node]

      def self.from_source: (String sdl) -> DocumentAST
      def self.from_document: (_Document document) -> DocumentAST

      def initialize: () -> void
      def add: (_Node definition) -> void
      # Adds a type, or replaces the one of the same name.
      def put_type: (_NamedNode definition) -> self
      def remove_type: (String name) -> self
      def remove_directive: (String name) -> self
      # Adds the type parsed from the SDL (or the block's), unless one of the name exists.
      def define_type: (String name, ?String? sdl) ?{ () -> String } -> _NamedNode
      def type?: (String name) -> bool
      def type_names: () -> Array[String]
      def to_document: () -> _Document
      def to_sdl: () -> String
    end

    # The manipulation phase: extensions merged, then the type, field and argument manipulators.
    module ASTBuilder
      ROOT_TYPES: Array[String]
      # graphql-ruby's own directives, whose definitions the SDL may repeat.
      BUILT_IN_DIRECTIVES: Array[String]

      def self?.build: (String sdl, ?registry: DirectiveRegistry) -> String
    end

    # Apollo's Automatic Persisted Queries, and a manifest of trusted operations.
    module PersistedQueries
      HASH: Regexp
      NOT_FOUND: Array[String]
      NOT_SUPPORTED: Array[String]
      HASH_MISMATCH: Array[String]
      NOT_IN_LIST: Array[String]

      # A request the protocol rejects, rendered with Apollo's error codes.
      class Error < StandardError
        attr_reader code: String

        def initialize: (String message, String code) -> void
        def to_h: () -> Hash[String, json]
      end

      # `extensions` as a request carries it: a Hash, a JSON String (GET) or
      # ActionController::Parameters.
      type extensions = Hash[String | Symbol, untyped] | String | _Parameters

      # `extensions` as the request carries it: a Hash, a JSON String (GET) or
      # ActionController::Parameters.
      #
      # `schema.execute` with the query the request names: its result, or a
      # protocol error as a ready-to-render { "errors" => [...] } Hash.
      def self?.execute: (schema schema, query: String?, ?extensions: extensions?, ?variables: Hash[String, untyped]?,
                          ?operation_name: String?, ?context: Hash[Symbol, untyped], **untyped options) -> _Result
      # `execute` for a response that may be streamed (Defer): yields the started
      # Incremental::Run and answers what the block does, or a protocol error as a
      # ready-to-render Hash. The operation ends once the run is done, or the block.
      def self?.incremental: [T] (schema schema, query: String?, ?extensions: extensions?, ?variables: Hash[String, untyped]?,
                                  ?operation_name: String?, ?context: Hash[Symbol, untyped], **untyped options) { (Incremental::Run run) -> T } -> (T | Hash[String, json])
      # A batch: `schema.multiplex` with the query each operation (a Hash of
      # query, extensions, variables, operation_name, context) names. One result
      # per operation, in order; a protocol error is a ready-to-render Hash.
      def self?.multiplex: (schema schema, Array[Hash[Symbol | String, untyped]] operations, **untyped options) -> Array[_Result]
      # The query text to run for a request's `query` and `extensions`.
      def self?.resolve: (String? query, extensions? extensions) -> String?
      def self?.enabled?: () -> bool
      def self?.digest: (String query) -> String
      # Store a query ahead of time (e.g. from a deploy task); returns its hash.
      def self?.register: (String query) -> String
    end

    # A concern for a GraphQL::Schema::Subscription (graphql-ruby ships no RBS, so
    # the class it is included in is not declared): PHP Lighthouse's hooks and
    # topic. All optional. `object` is the broadcast root and `context` the
    # subscriber's. Including it elsewhere raises Lighthouse::DefinitionError.
    module Subscription
      # May this client subscribe? Called with the subscription request only.
      def authorize?: (**untyped args) -> boolish
      # Should this subscriber receive the broadcast of `root` (what the
      # mutation returned, the app's)? `args` are the arguments it subscribed with.
      def filter?: (untyped root, **untyped args) -> boolish
      # The value an update resolves the field with: the app's.
      def resolve_payload: (untyped root, **untyped args) -> untyped

      # The class methods the concern adds to its includer.
      module ClassMethods
        # :field (default): every subscriber shares the field's topic and filter?
        # decides; :arguments: graphql-ruby's, subscribers match the trigger's arguments.
        def topic_by: (?(:field | :arguments)? mode) -> (:field | :arguments)
        def topic_for: (arguments: arguments, field: _FieldDefinition, scope: untyped) -> String
        # What @broadcast triggers the subscription with, for the root a mutation returned.
        def trigger_arguments: (untyped root, context context) -> Hash[Symbol | String, untyped]
        def trigger_scope: (untyped root, context context) -> untyped
      end

      # What a Subscription field with no class of its own resolves to.
      class Default
      end
    end

    # The Cache-Control header the selected fields' @cacheControl hints allow.
    module CacheControl
      DEFINITION: String
      TYPE_DEFINITIONS: Hash[String, String]
      CONTEXT_KEY: Symbol

      # For an executed query (a GraphQL::Query::Result or GraphQL::Query);
      # nil when the schema does not use @cacheControl.
      def self?.header: (_Result | _Query result) -> String?
      # Set the header on a Rails response, and return it.
      def self?.apply: (_ResponseHeaders response, _Result | _Query result) -> String?
    end

    # What fields cost in graphql-ruby's complexity analysis (@complexity, and
    # paginated fields scaled by `first`).
    module Complexity
      DEFINITION: String
      CONTEXT_KEY: Symbol

      # Give the schema's fields their cost; `root_kinds` maps root type names to
      # :queries / :mutations / :subscriptions.
      def self?.apply: (_Schema schema, ?Hash[String, Symbol] root_kinds) -> void
      # A query's score, once scored for BuildExtensionsResponse; nil otherwise.
      def self?.query_complexity: (_Query query) -> Integer?
    end

    # A concern for a GraphQL::Analysis::Analyzer that @complexity(resolver:)
    # names (graphql-ruby ships no RBS, so the class it is included in is not
    # declared): its `complexity` is the cost of the fields naming the class.
    module ComplexityAnalyzer
      # Only when the class has a `result` of its own.
      def analyze?: () -> bool
      def result: () -> nil

      # The class methods the concern adds to its includer.
      module ClassMethods
        # A number (added to the selection's cost) or a proc of
        # (context, args, child_complexity); nil when never set.
        def complexity: (?(Numeric | ^(context, arguments, Integer) -> Integer)? new_complexity) -> (Numeric | ^(context, arguments, Integer) -> Integer)?
      end
    end

    # @defer (experimental; the specification it follows is a draft): a graphql-ruby
    # plugin, `use Lighthouse::GraphQL::Defer` in the schema class. The controller
    # streams the response when the controller includes ActionController::Live and
    # the client accepts `multipart/mixed`.
    module Defer
      MULTIPART: String
      OLD_FORMAT: String
      FORMAT: String
      JSON_TYPES: Array[String]
      GRAPHQL: String

      # graphql-ruby's plugin hook.
      def self?.use: (schema schema, **untyped options) -> void
      # Does the schema use the plugin? `use` extends the schema class with Used.
      def self?.enabled?: (schema schema) -> bool
      module Used
      end
      # The Content-Type of the streamed response to `accept`, or nil when the client does not
      # prefer one to JSON.
      def self?.stream_type: (String? accept) -> String?
      # The request's stream_type, its Accept header read once (kept under ENV_KEY).
      def self?.stream_type_of: (_Request request) -> String?
      ENV_KEY: String

      # A route constraint: does the request prefer a streamed response?
      module Streaming
        def self.matches?: (_RoutedRequest request) -> bool
      end
      # Each media range of the header, and the multipart/mixed one the client prefers to JSON.
      def self?.ranges: (String? accept) -> Array[MediaRange]
      def self?.preferred: (String? accept) -> MediaRange?
      def self?.best: (Array[MediaRange] ranges) { (MediaRange) -> bool } -> MediaRange?

      # A media range of an Accept header.
      class MediaRange
        attr_reader type: String
        attr_reader params: Array[String]
        attr_reader q: Float
        attr_reader index: Integer
        def rank: () -> [Float, Integer]
        def streams?: () -> bool
        def json?: () -> bool
        def before?: (MediaRange? other) -> bool
      end
    end

    module Incremental
      # One operation, run in as many passes as @defer asks for.
      class Run
        # `options` are `schema.execute`'s: variables:, operation_name:, context:.
        # A nil query string (a request without one) is answered as graphql-ruby answers it.
        def initialize: (schema schema, String? query_string, **untyped options) -> void
        # Runs the first pass; returns self. The block gets what ends the operation (see finish).
        def start: () ?{ (_Result result) -> void } -> Run
        # Calls start's block, once: with the first pass's result when nothing was deferred, else the response so far.
        def finish: () -> void
        # The first pass's result.
        def result: () -> _Result
        # Are fragments pending?
        def deferred?: () -> bool
        # The initial payload, then one per round of deferred fragments, until `hasNext` is false.
        def each_payload: () { (Hash[String, json]) -> void } -> void
        # The whole response: the data and the errors of every round the client was sent ({} if none).
        def response: () -> Hash[String, json]
      end

      # The parts of a `multipart/mixed` response (graphql-over-http's IncrementalDelivery).
      class Multipart
        CONTENT_TYPE: String
        PART_HEADERS: String

        def self.headers: (?String content_type) -> Hash[String, String]
        def initialize: (_Stream stream) -> void
        # The part of a payload, encoded as render json: does (the payload holds the app's values:
        # a Time, an object's as_json; their errors are raised here).
        def part: (Hash[String, untyped] payload) -> String
        # Writes an encoded part (the stream's errors are raised here).
        def emit: (String part) -> void
        def started?: () -> bool
        def finish: () -> void
        # The response, its stream closed, as EndRequest carries it: its body the parts written.
        def ended: (_StreamedResponse response) -> Response

        class Response
          def initialize: (_StreamedResponse response, String body) -> void
          def body: () -> String
        end
      end

      interface _Stream
        def write: (String data) -> untyped
      end
    end

    # The opt-in cache of the manipulated schema document, in tmp/cache.
    module SchemaCache
      PREFIX: String

      def self?.enabled?: () -> bool
      def self?.directory: () -> path
      # Build the schema document now and return the cache file's path.
      def self?.warm!: (?String? sdl) -> String
      def self?.clear!: () -> void
    end
  end
end
