# The Rails controller concerns that run and serve a schema. See docs/getting-started.md.
module Lighthouse
  module GraphQL
    # Run an operation from any action, with the context the endpoint gives it.
    module Operations
      module ClassMethods
        # The schema the operations run on: a schema class, its name (constantized
        # per request) or a block (evaluated in the controller, per request).
        def lighthouse_schema: (?(_Schema | String | Symbol)? schema) ?{ () -> _Schema } -> (_Schema | String | Symbol | Proc)?
      end

      private

      # The operation's result, or nil when a @throttle performed the response.
      def lighthouse_execute: (String? query, ?variables: (Hash[String | Symbol, untyped] | String | _Parameters)?, ?operation_name: String?,
                               ?extensions: GraphQL::PersistedQueries::extensions?, ?context: Hash[Symbol, untyped]) -> Hash[String, json]?

      # Dispatch StartRequest, yield, dispatch EndRequest; only the outermost call does.
      def lighthouse_request: [T] () { () -> T } -> T

      # The operation's context; { current_user: current_user } when the controller has one.
      def graphql_context: () -> Hash[Symbol, untyped]

      # graphql_context, with what @throttle reads: remote_ip and the controller.
      def lighthouse_context: () -> Hash[Symbol, untyped]

      # The schema class `lighthouse_schema` names.
      def graphql_schema: () -> _Schema

      # The `variables` parameter as a Hash: from a JSON String, a Hash or parameters.
      def graphql_variables: ((Hash[String | Symbol, untyped] | String | _Parameters)? param) -> Hash[String | Symbol, untyped]
    end

    module Controller
      include Operations

      # The action: dispatches StartRequest, runs the operation (or a batch),
      # sets Cache-Control, renders JSON (or streams an operation that defers, when the
      # schema uses Defer), dispatches EndRequest.
      def execute: () -> void
    end

    # Requests to the app's endpoint from its tests (PHP Lighthouse's MakesGraphQLRequests),
    # in Rails' integration session. Each answers the response's parsed body.
    module Testing : _IntegrationSession
      class NotStreamed < StandardError
      end

      def graphql: (String query, ?Hash[String | Symbol, untyped] variables, ?extra_params: Hash[String | Symbol, untyped],
                    ?headers: Hash[String, String]) -> untyped
      def post_graphql: (Hash[String | Symbol, untyped] | Array[Hash[String | Symbol, untyped]] data, ?headers: Hash[String, String]) -> untyped
      def multipart_graphql: (Hash[String | Symbol, untyped] operations, Hash[String, Array[String]] map, Hash[String | Symbol, untyped] files,
                              ?headers: Hash[String, String]) -> untyped
      def introspect: () -> untyped
      def introspect_type: (String name) -> Hash[String, untyped]?
      def introspect_directive: (String name) -> Hash[String, untyped]?
      # The payloads of a streamed response; NotStreamed when it came whole.
      def stream_graphql: (String query, ?Hash[String | Symbol, untyped] variables, ?extra_params: Hash[String | Symbol, untyped],
                           ?headers: Hash[String, String]) -> Array[Hash[String, json]]
      def graphql_endpoint: () -> String
    end

    # Rails' integration session (ActionDispatch::Integration::Runner), as Testing uses it.
    interface _IntegrationSession
      def post: (String path, ?params: untyped, ?headers: Hash[String, String]) -> untyped
      def response: () -> _TestResponse
    end

    interface _TestResponse
      def parsed_body: () -> untyped
      def body: () -> String
      def content_type: () -> String?
    end
  end
end
