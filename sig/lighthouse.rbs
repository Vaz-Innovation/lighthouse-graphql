# Signatures for the parts of Lighthouse an application implements or calls:
# the classes a schema names (builders, validators), the configuration, the
# directive extension points and the entrypoints. Internals are left out.
#
# graphql-ruby, Active Record and Rails ship no RBS every app has, so what
# Lighthouse takes from them is declared here as interfaces of the methods it
# uses: GraphQL::Schema is a _Schema, GraphQL::Query::Context a _Context, an
# ActiveRecord::Relation a _Relation. Any object answering those methods
# conforms, the gem depends on no one else's signatures, and `rake rbs:test`
# checks the real values against them. What stays `untyped` is the app's own
# (a user, a record a resolver returns, a client's argument value).
module Lighthouse
  # --- graphql-ruby ----------------------------------------------------------

  # A GraphQL::Schema subclass (the class itself), as Lighthouse builds it.
  interface _Schema
    def execute: (?String? query, **untyped options) -> _Result
    def multiplex: (Array[Hash[Symbol, untyped]] queries, **untyped options) -> Array[_Result]
    def validate: (String | _Document query, **untyped options) -> Array[_Error]
    def to_definition: () -> String
    def types: () -> Hash[String, _NamedType]
  end

  # A GraphQL::Query::Result, or a ready-to-render Hash ({ "errors" => [...] }).
  interface _Result
    def to_h: () -> Hash[String, json]
  end

  # A GraphQL::StaticValidation::Error, or any error graphql-ruby reports.
  interface _Error
    def message: () -> String
  end

  # A GraphQL::Query: one operation of a request.
  interface _Query
    def selected_operation_name: () -> String?
    def context: () -> _Context
  end

  # The request's GraphQL::Query::Context, or a Hash standing in for one.
  interface _Context
    def []: (Symbol | String key) -> untyped
  end

  # A graphql-ruby type: an object, interface, input, enum, scalar or union class.
  interface _NamedType
    def graphql_name: (?String? name) -> String
  end

  # A GraphQL::Schema::Field or GraphQL::Schema::Argument, as built from the SDL.
  interface _SchemaMember
    def graphql_name: () -> String
    def ast_node: () -> _Node?
  end

  # A GraphQL::Schema::Field: a member with arguments.
  interface _FieldDefinition
    include _SchemaMember
    def arguments: () -> Hash[String, _SchemaMember]
  end

  # What resolves a field: graphql-ruby's resolver signature, (object, arguments,
  # context). The object and the value are the app's.
  interface _Resolver
    def call: (untyped object, untyped arguments, context? context) -> untyped
  end

  # A field's arguments as graphql-ruby hands them over (GraphQL::Execution::
  # Interpreter::Arguments), or a Hash.
  interface _ArgumentSet
    def to_h: () -> Hash[Symbol, untyped]
  end

  # A GraphQL::Language::Nodes node: a document, a definition, a directive, ...
  interface _Node
    def to_query_string: () -> String
  end

  # Anything with a name: an AST node, a directive's argument.
  interface _Named
    def name: () -> String
  end

  # A node with a name: a type or directive definition, a field, a directive.
  interface _NamedNode
    include _Node
    include _Named
  end

  # A parsed GraphQL::Language::Nodes::Document.
  interface _Document
    include _Node
    def definitions: () -> Array[_Node]
  end

  # A directive as the SDL applies it (`@paginate(defaultCount: 10)`): its
  # name and its arguments (each a name and a value).
  interface _DirectiveNode
    include _Named
    def arguments: () -> Array[_Named]
  end

  # --- Active Record ---------------------------------------------------------

  # An ActiveRecord::Relation, or a model class (which answers the same).
  interface _Relation
    def where: (*untyped conditions) -> _Relation
    def order: (*untyped orders) -> _Relation
    def limit: (Integer? count) -> _Relation
  end

  type relation = _Relation

  # An ActiveRecord::Relation, which knows its model (a model class does not answer `klass`).
  interface _ModelRelation
    include _Relation
    def klass: () -> Class
  end

  # An Arel attribute or SQL literal, which predicates build on.
  interface _ArelNode
    def eq: (untyped other) -> _ArelNode
  end

  # A model instance.
  interface _Record
    def id: () -> (Integer | String | Array[Integer | String])?
    def persisted?: () -> bool
  end

  # --- Rails -----------------------------------------------------------------

  # An ActionDispatch::Request.
  interface _Request
    def path: () -> String
    def headers: () -> untyped
  end

  # What has response headers: an ActionDispatch::Response.
  interface _ResponseHeaders
    def headers: () -> Hash[String, untyped]
  end

  # An ActionDispatch::Response.
  interface _Response
    include _ResponseHeaders
    def status: () -> Integer
  end

  # ActionController::Parameters, read whole.
  interface _Parameters
    def to_unsafe_h: () -> Hash[String, untyped]
  end

  # An ActiveSupport::Cache::Store, Rails.cache by default.
  interface _CacheStore
    def read: (String key, **untyped options) -> untyped
    def write: (String key, untyped value, **untyped options) -> boolish
  end

  # A Logger, Rails.logger by default.
  interface _Logger
    def info: (?String? message) -> void
    def warn: (?String? message) -> void
    def error: (?String? message) -> void
  end

  # --- Values ----------------------------------------------------------------

  # A field's arguments, with snake_case Symbol keys as graphql-ruby passes them.
  # A value is whatever the client sent for the argument's type.
  type arguments = Hash[Symbol, untyped]

  type context = _Context

  # A literal a directive is written with in the SDL: `@paginate(defaultCount: 10)`,
  # `@can(ability: "x", args: [1, "a"])`. Enum values are Strings.
  type literal = String | Integer | Float | bool | nil | Array[literal] | Hash[String, literal]

  # What a response's extensions, or a JSON document, may hold.
  type json = String | Integer | Float | bool | nil | Array[json] | Hash[String | Symbol, json]

  # A @validator's errors: messages by key, nested for input objects.
  type validation_errors = Hash[Symbol | String, Array[String] | validation_errors]

  # A path on disk: a String or a Pathname.
  type path = String | _ToPath

  # A class `@builder(class: "Name")` names, looked up in Config.namespaces[:builders].
  # It refines the relation of a field resolved by @all, @paginate, @first,
  # @count or @aggregate and returns the relation to use; nil keeps the one it
  # was given. `@builder(method:)` names a method other than `call`, with the
  # same signature. The class answers it, or else an instance built with no
  # arguments does. A GraphQL::ExecutionError it raises reaches the client.
  interface _Builder
    def call: (relation relation, arguments args, context context) -> relation?
  end

  # A @validator contract other than a Dry::Validation::Contract: it gets the
  # arguments (snake_case Symbol keys) and answers the errors by key,
  # { title: ["is missing"] }, nested for input objects; empty when valid.
  interface _Validator
    def call: (arguments values) -> validation_errors
  end

  # Config.on_error: called with an error a directive or resolver swallowed.
  interface _ErrorHandler
    def call: (StandardError error, context? context) -> void
  end

  # Config.global_id: encodes and decodes Relay global ids (@globalId, @node).
  interface _GlobalId
    def encode: (String type, String | Integer id) -> String
    def decode: (String global_id) -> Array[String]
  end

  # Config.authenticated_user and Config.policy_user: the user of a request,
  # an object of the app's own (nil for a guest).
  interface _UserReader
    def call: (context? context) -> untyped
  end

  # Config.authorizer: may `user` perform `ability` on `record` (a model
  # instance, or a model class for @canModel)? `args` are the @can* `args:`,
  # after the field's arguments with `injectArgs: true`.
  interface _Authorizer
    def call: (untyped user, _Record | Class record, String | Symbol ability, ?Array[untyped] args) -> boolish
  end

  # Config.feature_checker: is the feature `name` (as written in @feature) on
  # for `actor`? The default asks Flipper.
  interface _FeatureChecker
    def call: (String name, untyped actor, context? context) -> boolish
  end

  # Config.soft_deletes: what "trashed" means for @softDeletes, @trashed,
  # @restore, @forceDelete and @withoutGlobalScopes. The filters take a model's
  # relation and answer the constrained one; `restore` and `force_delete` act
  # on a record and answer whether they succeeded. It may also answer
  # `column(model)` and `kept_value(model)`: the column that marks trashed records
  # and its value for the others, which a Searchkick search filters on.
  interface _SoftDeletes
    def soft_deletes?: (Class model) -> boolish
    def only_trashed: (relation relation) -> relation
    def with_trashed: (relation relation) -> relation
    def without_trashed: (relation relation) -> relation
    def restore: (_Record record) -> boolish
    def force_delete: (_Record record) -> boolish
  end

  # Config.search: what searches a model (see Lighthouse::Search). The protocol is
  # experimental. `searchable?` says whether the model can be searched, within
  # the pg_search scope or the index `index` names. A relational adapter
  # (pg_search) narrows the field's relation, and every other directive applies
  # on top; the others answer a page of records and the total, and take only
  # the directives that include Contracts::SearchBuilder.
  interface _SearchAdapter
    def searchable?: (Class model, ?String? index) -> boolish
    def relational?: () -> boolish
  end

  interface _RelationalSearchAdapter
    include _SearchAdapter
    def scope: (relation relation, Search::Query query) -> relation
  end

  # `page` answers one entry per hit, nil for a hit it could not load, and the total: every match, counted.
  # It may answer `model_error(model)`: why a model cannot be searched as it is, which
  # Search::FieldCheck makes a schema error.
  # It may also answer `result_window(query)`: how many matches it pages through
  # (Search::Result::MAX_WINDOW when it does not), or nil when it cannot tell.
  interface _EngineSearchAdapter
    include _SearchAdapter
    def page: (Search::Query query, offset: Integer, limit: Integer) -> [Array[_Record?], Integer]
  end

  # Search::Auto: picks the adapter per model.
  interface _SearchAdapterChooser
    def adapter_for: (Class model, ?String? index) -> _SearchAdapter?
  end

  # What DirectiveRegistry#register_manipulator takes: it transforms the SDL
  # before the schema is built.
  interface _SdlManipulator
    def manipulate: (String sdl) -> String
  end

  def self.configure: () ?{ (singleton(Config) config) -> void } -> void

  # Trusted operations: { sha256 => query }, or Apollo's manifest
  # ({ "operations" => [{ "id" => sha256, "body" => query }] }).
  type manifest = Hash[String | Symbol, String | Array[Hash[String | Symbol, String]] | Integer]
  type manifest_source = path | manifest | ^() -> (path | manifest)?

  module Config
    DEFAULT_NAMESPACES: Hash[Symbol, Array[String]]
    SETTINGS: Array[Symbol]

    def self.configure: () ?{ (singleton(Config) config) -> void } -> void
    # A setting by name: its value, of the setting's type.
    def self.[]: (Symbol | String key) -> untyped
    def self.reset!: () -> void

    # The schema's entrypoint, which imports the other files (SchemaStitcher).
    def self.schema_path: () -> path?
    def self.schema_path=: (path? path) -> path?
    def self.schema_directory: () -> String?

    # Rewrite the IDE helper files on boot and every reload; nil: in development with a graphql.config.yml.
    def self.ide_helper: () -> bool?
    def self.ide_helper=: (bool? enabled) -> bool?

    # The file development keeps the client schema in: a path, or { path:, schema: }; nil: none.
    def self.schema_output: () -> (path | { path: path, ?schema: String })?
    def self.schema_output=: ((path | { path: path, ?schema: String })? output) -> (path | { path: path, ?schema: String })?

    # Log the schema's build on boot and every reload; nil: in a development server.
    # The most deferred fragments one request may leave pending (Defer); default 100.
    def self.defer_max_pending: () -> Integer
    def self.defer_max_pending=: (Integer? count) -> Integer?

    def self.schema_log: () -> bool
    def self.schema_log=: (bool? enabled) -> bool?

    # { queries:, mutations:, subscriptions:, builders:, validators:, events: } => [namespace, ...].
    # Assigning a partial hash overrides only the kinds it names.
    def self.namespaces: () -> Hash[Symbol, Array[String]]
    def self.namespaces=: (Hash[Symbol | String, String | Array[String]] overrides) -> Hash[Symbol | String, String | Array[String]]

    def self.resolver_namespaces: () -> Array[String]
    def self.resolver_namespaces=: (Array[String] namespaces) -> Array[String]

    # An ActiveSupport::Cache::Store; Rails.cache by default.

    def self.transactional_mutations: () -> bool
    def self.transactional_mutations=: (bool? enabled) -> bool?

    def self.pagination_default_count: () -> Integer?
    def self.pagination_default_count=: (Integer? count) -> Integer?
    def self.pagination_max_count: () -> Integer?
    def self.pagination_max_count=: (Integer? count) -> Integer?

    def self.schema_cache: () -> bool
    def self.schema_cache=: (bool? enabled) -> bool?
    def self.schema_cache_path: () -> path?
    def self.schema_cache_path=: (path? path) -> path?
    def self.watch_sdl: () -> bool
    def self.watch_sdl=: (bool? enabled) -> bool?

    def self.persisted_queries: () -> bool
    def self.persisted_queries=: (bool? enabled) -> bool?
    def self.persisted_queries_store: () -> _CacheStore
    def self.persisted_queries_store=: (_CacheStore? store) -> _CacheStore?
    def self.persisted_queries_ttl: () -> Numeric?
    def self.persisted_queries_ttl=: (Numeric? seconds) -> Numeric?
    # A JSON file, a Hash of operations, or a callable answering either.
    def self.persisted_queries_manifest: () -> manifest_source?
    def self.persisted_queries_manifest=: (manifest_source? manifest) -> manifest_source?
    def self.persisted_queries_only: () -> bool
    def self.persisted_queries_only=: (bool? enabled) -> bool?

    def self.convert_empty_strings_to_null: () -> bool
    def self.convert_empty_strings_to_null=: (bool? enabled) -> bool?

    def self.global_id: () -> _GlobalId
    def self.global_id=: (_GlobalId? codec) -> _GlobalId?


    # Whether @broadcast triggers in an ActiveJob (Lighthouse::GraphQL::BroadcastJob)
    # unless the directive says shouldQueue; and the job's queue (nil: ActiveJob's default).
    def self.queue_broadcasts: () -> bool
    def self.queue_broadcasts=: (bool? enabled) -> bool?
    def self.broadcast_queue: () -> (String | Symbol)?
    def self.broadcast_queue=: ((String | Symbol)? queue) -> (String | Symbol)?

    def self.on_error: () -> _ErrorHandler
    def self.on_error=: (_ErrorHandler? handler) -> _ErrorHandler?
    def self.handle_error: (StandardError error, ?context? context) -> void

    def self.authenticated_user: () -> _UserReader
    def self.authenticated_user=: (_UserReader? reader) -> _UserReader?
    def self.policy_user: () -> _UserReader
    def self.policy_user=: (_UserReader? reader) -> _UserReader?
    def self.authorizer: () -> _Authorizer
    def self.authorizer=: (_Authorizer? authorizer) -> _Authorizer?

    def self.soft_deletes: () -> _SoftDeletes?
    def self.soft_deletes=: (_SoftDeletes? adapter) -> _SoftDeletes?

    # What searches a model for @search; nil: detected per model (Search::Auto).
    def self.search: () -> (_SearchAdapter | _SearchAdapterChooser)?
    def self.search=: ((_SearchAdapter | _SearchAdapterChooser)? adapter) -> (_SearchAdapter | _SearchAdapterChooser)?

    def self.feature_checker: () -> _FeatureChecker
    def self.feature_checker=: (_FeatureChecker? checker) -> _FeatureChecker?
    def self.feature_actor: () -> _UserReader
    def self.feature_actor=: (_UserReader? reader) -> _UserReader?
  end

  module Support
    module SoftDeletes
      # :only, :with or :without, for a Trashed enum value; a client error for any other.
      def self.trashed: (untyped value) -> (:only | :with | :without)
      # The column that marks the model's trashed records, as the adapter tells it, and its value for the others.
      def self.column: (Class model) -> String?
      def self.kept_value: (Class model) -> untyped

      # A nullable timestamp column marking trashed records, with no gem:
      # `Config.soft_deletes = Support::SoftDeletes::Column.new(:archived_at)`.
      class Column
        include _SoftDeletes

        DEFAULT_COLUMN: String

        def initialize: (?String | Symbol column) -> void

        # The column that marks trashed records, and its value for the others, for a search engine to filter on.
        def column: (Class model) -> String
        def kept_value: (Class model) -> nil
      end
    end
  end

  # The schema refers to something that does not exist or breaks a contract.
  class DefinitionError < StandardError
  end

  # A GraphQL::ExecutionError (declared from StandardError, which it descends
  # from, as graphql-ruby ships no RBS): the @can* family denied the ability
  # (extensions.code FORBIDDEN).
  class AuthorizationError < StandardError
    CODE: String

    def initialize: (?String message, ?extensions: Hash[String, json], ?ast_node: _Node?, ?ast_nodes: Array[_Node]?, ?options: Hash[String, json]?) -> void
  end

  # A GraphQL::ExecutionError: @guard or @auth found no signed-in user (extensions.code UNAUTHENTICATED).
  class AuthenticationError < StandardError
    CODE: String

    def initialize: (?String message, ?extensions: Hash[String, json], ?ast_node: _Node?, ?ast_nodes: Array[_Node]?, ?options: Hash[String, json]?) -> void
  end

  # A GraphQL::ExecutionError: invalid arguments, keyed by argument path
  # ({ "input.title" => ["Title can't be blank"] }) under extensions.validation.
  class ValidationError < StandardError
    attr_reader messages: Hash[String, Array[String]]

    def initialize: (String | Symbol field_name, Hash[String, Array[String]] messages) -> void
  end
end
