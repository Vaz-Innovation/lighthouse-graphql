# Signatures for the parts of Lighthouse an application implements or calls:
# the classes a schema names (builders, validators), the configuration, the
# directive extension points and the entrypoints. Internals are left out.
#
# graphql-ruby and Active Record ship no RBS every app has, so the values that
# come from them are aliases of untyped, named for what they hold.
module Lighthouse
  # An ActiveRecord::Relation, or anything with its query interface.
  type relation = untyped

  # A field's arguments, with snake_case Symbol keys as graphql-ruby passes them.
  type arguments = Hash[Symbol, untyped]

  # The request's GraphQL::Query::Context.
  type context = untyped

  # A path on disk: a String or a Pathname.
  type path = String | _ToPath

  # A class `@builder(class: "Name")` names, looked up in Config.namespaces[:builders].
  # It refines the relation of a field resolved by @all, @paginate, @first,
  # @count or @aggregate and returns the relation to use; nil keeps the one it
  # was given. `@builder(method:)` names a method other than `call`, with the
  # same signature. The class answers it, or else an instance built with no
  # arguments does. A GraphQL::ExecutionError it raises reaches the client.
  interface _Builder
    def call: (relation relation, arguments args, context context) -> relation?
  end

  # A @validator contract other than a Dry::Validation::Contract: it gets the
  # arguments (snake_case Symbol keys) and answers the errors by key,
  # { title: ["is missing"] }, nested for input objects; empty when valid.
  interface _Validator
    def call: (Hash[Symbol, untyped] values) -> Hash[Symbol | String, untyped]
  end

  # Config.on_error: called with an error a directive or resolver swallowed.
  interface _ErrorHandler
    def call: (StandardError error, context? context) -> void
  end

  # Config.global_id: encodes and decodes Relay global ids (@globalId, @node).
  interface _GlobalId
    def encode: (String type, untyped id) -> String
    def decode: (String global_id) -> Array[String]
  end

  # Config.authenticated_user and Config.policy_user: the user of a request.
  interface _UserReader
    def call: (context? context) -> untyped
  end

  # Config.authorizer: may `user` perform `ability` on `record` (a model
  # instance, or a model class for @canModel)? `args` are the @can* `args:`,
  # after the field's arguments with `injectArgs: true`.
  interface _Authorizer
    def call: (untyped user, untyped record, String | Symbol ability, ?Array[untyped] args) -> boolish
  end

  # Config.feature_checker: is the feature `name` (as written in @feature) on
  # for `actor`? The default asks Flipper.
  interface _FeatureChecker
    def call: (String name, untyped actor, context? context) -> boolish
  end

  # Config.soft_deletes: what "trashed" means for @softDeletes, @trashed,
  # @restore, @forceDelete and @withoutGlobalScopes. The filters take a model's
  # relation and answer the constrained one; `restore` and `force_delete` act
  # on a record and answer whether they succeeded.
  interface _SoftDeletes
    def soft_deletes?: (Class model) -> boolish
    def only_trashed: (relation relation) -> relation
    def with_trashed: (relation relation) -> relation
    def without_trashed: (relation relation) -> relation
    def restore: (untyped record) -> boolish
    def force_delete: (untyped record) -> boolish
  end

  # What DirectiveRegistry#register_manipulator takes: it transforms the SDL
  # before the schema is built.
  interface _SdlManipulator
    def manipulate: (String sdl) -> String
  end

  def self.configure: () ?{ (singleton(Config) config) -> void } -> void

  module Config
    DEFAULT_NAMESPACES: Hash[Symbol, Array[String]]
    SETTINGS: Array[Symbol]

    def self.configure: () ?{ (singleton(Config) config) -> void } -> void
    def self.[]: (Symbol | String key) -> untyped
    def self.reset!: () -> void

    # The schema's entrypoint, which imports the other files (SchemaStitcher).
    def self.schema_path: () -> path?
    def self.schema_path=: (path? path) -> path?
    def self.schema_directory: () -> String?

    # Rewrite the IDE helper files on boot and every reload; nil: in development with a graphql.config.yml.
    def self.ide_helper: () -> bool?
    def self.ide_helper=: (bool? enabled) -> bool?

    # { queries:, mutations:, subscriptions:, builders:, validators:, events: } => [namespace, ...].
    # Assigning a partial hash overrides only the kinds it names.
    def self.namespaces: () -> Hash[Symbol, Array[String]]
    def self.namespaces=: (Hash[Symbol | String, String | Array[String]] overrides) -> Hash[Symbol | String, String | Array[String]]

    def self.resolver_namespaces: () -> Array[String]
    def self.resolver_namespaces=: (Array[String] namespaces) -> Array[String]

    def self.directive_map: () -> Hash[untyped, untyped]

    # An ActiveSupport::Cache::Store; Rails.cache by default.

    def self.transactional_mutations: () -> bool
    def self.transactional_mutations=: (bool? enabled) -> bool?

    def self.pagination_default_count: () -> Integer?
    def self.pagination_default_count=: (Integer? count) -> Integer?
    def self.pagination_max_count: () -> Integer?
    def self.pagination_max_count=: (Integer? count) -> Integer?

    def self.schema_cache: () -> bool
    def self.schema_cache=: (bool? enabled) -> bool?
    def self.schema_cache_path: () -> path?
    def self.schema_cache_path=: (path? path) -> path?
    def self.watch_sdl: () -> bool
    def self.watch_sdl=: (bool? enabled) -> bool?

    def self.persisted_queries: () -> bool
    def self.persisted_queries=: (bool? enabled) -> bool?
    def self.persisted_queries_store: () -> untyped
    def self.persisted_queries_store=: (untyped store) -> untyped
    def self.persisted_queries_ttl: () -> Numeric?
    def self.persisted_queries_ttl=: (Numeric? seconds) -> Numeric?
    def self.persisted_queries_manifest: () -> path?
    def self.persisted_queries_manifest=: (path? path) -> path?
    def self.persisted_queries_only: () -> bool
    def self.persisted_queries_only=: (bool? enabled) -> bool?

    def self.convert_empty_strings_to_null: () -> bool
    def self.convert_empty_strings_to_null=: (bool? enabled) -> bool?

    def self.global_id: () -> _GlobalId
    def self.global_id=: (_GlobalId? codec) -> _GlobalId?


    # Whether @broadcast triggers in an ActiveJob (Lighthouse::GraphQL::BroadcastJob)
    # unless the directive says shouldQueue; and the job's queue (nil: ActiveJob's default).
    def self.queue_broadcasts: () -> bool
    def self.queue_broadcasts=: (bool? enabled) -> bool?
    def self.broadcast_queue: () -> (String | Symbol)?
    def self.broadcast_queue=: ((String | Symbol)? queue) -> (String | Symbol)?

    def self.on_error: () -> _ErrorHandler
    def self.on_error=: (_ErrorHandler? handler) -> _ErrorHandler?
    def self.handle_error: (StandardError error, ?context? context) -> void

    def self.authenticated_user: () -> _UserReader
    def self.authenticated_user=: (_UserReader? reader) -> _UserReader?
    def self.policy_user: () -> _UserReader
    def self.policy_user=: (_UserReader? reader) -> _UserReader?
    def self.authorizer: () -> _Authorizer
    def self.authorizer=: (_Authorizer? authorizer) -> _Authorizer?

    def self.soft_deletes: () -> _SoftDeletes?
    def self.soft_deletes=: (_SoftDeletes? adapter) -> _SoftDeletes?

    def self.feature_checker: () -> _FeatureChecker
    def self.feature_checker=: (_FeatureChecker? checker) -> _FeatureChecker?
    def self.feature_actor: () -> _UserReader
    def self.feature_actor=: (_UserReader? reader) -> _UserReader?
  end

  module Support
    module SoftDeletes
      # A nullable timestamp column marking trashed records, with no gem:
      # `Config.soft_deletes = Support::SoftDeletes::Column.new(:archived_at)`.
      class Column
        include _SoftDeletes

        DEFAULT_COLUMN: String

        def initialize: (?String | Symbol column) -> void
      end
    end
  end

  # The schema refers to something that does not exist or breaks a contract.
  class DefinitionError < StandardError
  end

  # A GraphQL::ExecutionError (declared from StandardError, which it descends
  # from, as graphql-ruby ships no RBS): the @can* family denied the ability.
  class AuthorizationError < StandardError
    def initialize: (?String message, **untyped options) -> void
  end

  # A GraphQL::ExecutionError: invalid arguments, keyed by argument path
  # ({ "input.title" => ["Title can't be blank"] }) under extensions.validation.
  class ValidationError < StandardError
    attr_reader messages: Hash[String, Array[String]]

    def initialize: (String | Symbol field_name, Hash[String, Array[String]] messages) -> void
  end
end
