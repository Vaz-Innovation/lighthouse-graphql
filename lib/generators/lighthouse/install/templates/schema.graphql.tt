# Starter schema generated by `rails generate lighthouse:install`. It assumes a
# User model with `name` and `email` columns — replace it with your own types.
# This file is the schema's entrypoint: split the schema into files it imports
# (#import user.graphql), which add their fields with `extend type Query`.
# Directives reference: https://github.com/Vaz-Innovation/lighthouse-graphql/blob/main/docs/directives.md

"Indicates what fields are available at the top level of a query operation."
type Query {
<% if relay? -%>
  "Fetches an object given its ID. Resolved by Types::QueryType#node, with <%= schema_name %>.object_from_id."
  node("ID of the object." id: ID!): Node

  "Fetches a list of objects given a list of IDs. Resolved by Types::QueryType#nodes."
  nodes("IDs of the objects." ids: [ID!]!): [Node]

  "Find a single user by its global id."
  user(id: ID! @globalId(decode: ID) @eq): User @find
<% else -%>
  "Find a single user by id."
  user(id: ID! @eq): User @find
<% end -%>

  "List users, a page at a time (10 by default; pass first: and page:)."
  users: [User!]! @paginate(defaultCount: 10)
}
<% if relay? -%>

"An object with an ID: graphql-ruby's Types::NodeType."
interface Node {
  "ID of the object."
  id: ID!
}

"Account of a person who uses this application. @node makes it a Node, which Query.node finds."
type User @node {
  "Its global id, from <%= schema_name %>.id_from_object (Rails' GlobalID)."
  id: ID! @globalId
  name: String
  email: String
}
<% else -%>

"Account of a person who uses this application."
type User {
  id: ID!
  name: String
  email: String
}
<% end -%>
