# graphql-config, read by the GraphQL plugins for JetBrains IDEs and VS Code.
# The two generated files describe Lighthouse's directives and the types it
# generates; refresh them after changing the schema:
#   bin/rails lighthouse:ide_helper
schema:
  - <%= sdl_folder %>/**/*.graphql
  - <%= Lighthouse::IdeHelper::DIRECTIVES_FILE %>
  - <%= Lighthouse::IdeHelper::PROGRAMMATIC_TYPES_FILE %>
